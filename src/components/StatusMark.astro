---
// The mark's colon segment as a status mark, drawn as SVG at its final size
// (10 by 15). The four kinds differ by shape, so they read without colour:
//   tested  filled
//   ready   outline, lower half filled
//   new     outline
//   wanted  dashed outline
// Strokes are 1.8 units in a 17.5-unit box, about 1px on screen. Colours come
// from the palette tokens in global.css (.mk rules).
interface Props {
  kind: "tested" | "ready" | "new" | "wanted";
}
const { kind } = Astro.props;
const d =
  "M45.45315,52.98381h8.15383c1.35097,0 2.27269,1.09518 2.05872,2.44615l-2.48989,15.72058c-0.42795,2.70194 -2.96522,4.8923 -5.66716,4.8923h-3.26153c-2.70194,0 -4.54538,-2.19035 -4.11743,-4.8923l2.48989,-15.72058c0.21397,-1.35097 1.48261,-2.44615 2.83358,-2.44615z";
---

<svg class:list={["mk", `mk--${kind}`]} viewBox="39.5 52 17.5 25" width="10" height="15" aria-hidden="true">
  {kind === "tested" && <path class="mk__fill" d={d} />}
  {kind === "ready" && <path class="mk__fill mk__half" d={d} />}
  {kind !== "tested" && <path class="mk__edge" d={d} />}
</svg>
