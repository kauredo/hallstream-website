---
// A plain labelled frame for a picture we don't have yet. Solid 1px rule, not
// dashed: a dashed frame reads as an upload drop zone (LEDGER, rejected).
import { t, fill } from "@/i18n";
import type { Lang } from "@/i18n/routes";
interface Props {
  lang: Lang;
  text: string;
  label: string;
  ratio: string;
  class?: string;
}
const { lang, text, label, ratio, class: cls = "" } = Astro.props;
---

<div role="img" aria-label={fill(t(lang).common.placeholder, { what: label })} class:list={["ph", cls]} style={`aspect-ratio:${ratio}`}>
  [{text}]
</div>
