---
// A screenshot in a 2px frame.
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  ratio: string;
  ink?: boolean;
  eager?: boolean;
}
const { src, alt, width, height, ratio, ink = false, eager = false } = Astro.props;
---

<div class:list={["frame", { "frame--ink": ink }]} style={`aspect-ratio:${ratio}`}>
  <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : undefined} />
</div>
