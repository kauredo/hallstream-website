---
// The drawn lockup from the brand package (scripts/brand-svgs.mjs), in
// currentColor, linking home.
import lockup from "@/assets/brand/lockup.svg?raw";
import { t } from "@/i18n";
import { path, type Lang } from "@/i18n/routes";
interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: cls = "" } = Astro.props;
const svg = lockup.replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
---

<a href={path("home", lang)} class:list={["lockup", cls]} aria-label={t(lang).common.homeLabel}><Fragment set:html={svg} /></a>
