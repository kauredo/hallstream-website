---
// The one action. The build reads the latest GitHub release. With none, the
// button says it follows the first release and links to the releases page;
// with one, it downloads the Windows file and the note names the version and
// size, then explains the SmartScreen warning an unsigned app gets.
import { t } from "@/i18n";
import type { Lang } from "@/i18n/routes";
import { getDownload } from "@/utils/release";
import { downloadCopy } from "@/utils/downloadCopy";
interface Props {
  lang: Lang;
  /** "long" names GitHub Releases; "short" does not. */
  note?: "long" | "short";
  /** "light" is Soalho, for Marcador bands; "dark" is Marcador, for Soalho. */
  tone?: "light" | "dark";
}
const { lang, note = "long", tone = "light" } = Astro.props;
const s = t(lang).common.download;
const dl = await getDownload();
const c = downloadCopy(dl, s, note);
---

<div class="get">
  <a class:list={["btn", `btn--${tone}`]} href={dl.url}>
    {
      c.file && (
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 2v11m0 0-4.5-4.5M10 13l4.5-4.5M3 17h14" fill="none" stroke="currentColor" stroke-width="2.2" />
        </svg>
      )
    }
    {c.label}
  </a>
  <p class="dl-note">{c.note}</p>
  {c.warning && <p class="dl-note">{c.warning}</p>}
  {c.notWindows && <p class="dl-note" data-not-windows hidden>{c.notWindows}</p>}
</div>

<script>
  import { detectPlatform } from "@/utils/platform";
  const os = detectPlatform();
  if (os === "macos" || os === "linux") {
    for (const el of document.querySelectorAll<HTMLElement>("[data-not-windows]")) el.hidden = false;
  }
</script>
