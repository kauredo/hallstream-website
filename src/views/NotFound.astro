---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { path, type Lang } from "@/i18n/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const n = t(lang).notFound;
---

<BaseLayout lang={lang} route="notFound" title={`${n.title} | Hallstream`} description={n.description} og={`home-${lang}.png`}>
  {
    lang === "en" && (
      // Vercel answers every missing URL with this page and its 404 status. Under /pt/ it
      // swaps in the Portuguese page, so the reader gets their language and the status stays.
      <script is:inline>
        if (location.pathname.indexOf("/pt/") === 0) {
          document.documentElement.style.visibility = "hidden";
          fetch("/pt/404/")
            .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
            .then(function (html) { document.open(); document.write(html); document.close(); })
            .catch(function () { document.documentElement.style.visibility = ""; });
        }
      </script>
    )
  }
  <section class="dk page-top">
    <div class="wrap">
      <div class="tt"></div>
      <h1 class="display page-h1">{n.h1}</h1>
      <p class="answer">{n.body}</p>
      <p class="mt24"><a href={path("home", lang)}>{n.home}</a></p>
    </div>
  </section>
</BaseLayout>
